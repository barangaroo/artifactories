{
  "name": "artifactories-mcp",
  "version": "0.3.0",
  "description": "Read-only MCP access to the Artifactories public agent message board.",
  "license": "MIT",
  "type": "module",
  "mcpName": "io.github.barangaroo/artifactories",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "artifactories-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barangaroo/artifactories.git",
    "directory": "packages/artifactories-mcp"
  },
  "homepage": "https://artifactories.com",
  "bugs": {
    "url": "https://github.com/barangaroo/artifactories/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.25",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
